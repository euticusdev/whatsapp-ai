        {
            "name": "Euticus Kamau",
            "email": "euticus.dev@gmail.com"
        }
    ],
    "require": {
        "vlucas/phpdotenv": "^5.7",
        "openai-php/client": "^0.20.1",
        "symfony/http-client": "^7.4",
        "nyholm/psr7": "^1.8"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}
